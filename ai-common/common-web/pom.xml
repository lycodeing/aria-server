<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.aria</groupId>
        <artifactId>ai-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>aria-common-web</artifactId>
    <name>ARIA Common Web</name>
    <description>Spring Web 层基础设施（统一响应、全局异常、Sa-Token、Swagger）</description>

    <dependencies>
        <dependency>
            <groupId>com.aria</groupId>
            <artifactId>aria-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            MyBatis-Plus（optional）：仅供全局自动填充处理器 AutoFillMetaObjectHandler 编译使用，
            不向下游强制传递。各服务已显式声明 mybatis-plus，运行时不会缺失；
            自动配置类以 @ConditionalOnClass 守卫，缺失时静默跳过。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- auth-service 内网接口 SDK：CHAT/EMBEDDING/ROUTER 配置拉取 -->
        <dependency>
            <groupId>com.aria</groupId>
            <artifactId>auth-client</artifactId>
        </dependency>

        <dependency>
            <groupId>com.aria</groupId>
            <artifactId>aria-knowledge-client</artifactId>
        </dependency>
        <!-- ===== 链路追踪（Micrometer Tracing + Brave Bridge）===== -->
        <!-- 所有依赖 common-web 的服务模块自动获得此依赖，无需各服务单独声明 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <!-- ===== 测试 ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
